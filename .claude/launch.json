{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.env",
        "apps/server/src/index.ts"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@echt/web",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "public",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@echt/web",
        "exec",
        "vite",
        "preview",
        "--outDir",
        "dist-public",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
