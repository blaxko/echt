{
  "name": "echt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run && pnpm --filter @echt/contracts test",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && pnpm --filter @echt/contracts typecheck",
    "seed:testnet": "pnpm --filter @echt/scripts seed",
    "sign:attestations": "pnpm --filter @echt/scripts sign",
    "scenarios:build": "pnpm --filter @echt/scripts scenarios build",
    "scenarios:fill": "pnpm --filter @echt/scripts scenarios fill",
    "lint": "eslint --config tools/lint/eslint.config.js ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "lighthouse": "^12.8.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "zod": ">=4.6.6"
    }
  }
}
